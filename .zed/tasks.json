[
  {
    "label": "g++ -std=c++20 -Wall -Wextra {File} -o {ZED_STEM}",
    "command": "g++",
    "args": ["-std=c++20", "-Wall", "-Wextra", "$ZED_FILE", "-o", "$ZED_STEM"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "./{ZED_STEM}",
    "command": "./$ZED_STEM",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
  },
]
